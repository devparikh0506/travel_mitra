# Copy to .env and fill in. Never commit the real .env.

# Host UID for file permissions on Linux/WSL (harmless on native Windows). 50000 is the airflow user.
AIRFLOW_UID=50000

# Airflow web UI admin login (used by airflow-init).
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Encrypts Airflow Connections/Variables. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Shared secret for the Airflow 3.x Task Execution API JWT (cross-container auth).
# A dev default exists in docker-compose; override here for anything non-local.
AIRFLOW__API_AUTH__JWT_SECRET=travelmitra-dev-jwt-secret-change-me

# API keys for ETL / agent.
TRIPADVISOR_API_KEY=
# Must match a domain allowlisted on the TripAdvisor key (sent as the Referer header).
TRIPADVISOR_REFERER=https://dev-parikh.com
GEMINI_API_KEY=

# LangSmith AI-usage tracing. Set LANGSMITH_TRACING=true and a key to enable.
# Create a key at https://smith.langchain.com (Settings -> API Keys).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-mitra
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
